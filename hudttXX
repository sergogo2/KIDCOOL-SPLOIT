local espObjects, espActive, rainbowConnection = {}, false, nil

local function createESPForPlayer(plr)
    if plr == player or espObjects[plr] then return end
    local char = plr.Character
    if not char then return end
    local highlight = Instance.new("Highlight")
    highlight.FillColor = Color3.fromRGB(255,0,0)
    highlight.OutlineColor = Color3.fromRGB(255,255,255)
    highlight.FillTransparency = 0.5
    highlight.OutlineTransparency = 0.2
    highlight.Adornee = char
    highlight.Parent = char
    local bill = Instance.new("BillboardGui")
    bill.Size = UDim2.new(0,200,0,40)
    bill.StudsOffset = Vector3.new(0,2.5,0)
    bill.AlwaysOnTop = true
    bill.Parent = char
    local textLabel = Instance.new("TextLabel")
    textLabel.Size = UDim2.new(1,0,1,0)
    textLabel.BackgroundTransparency = 1
    textLabel.Text = plr.Name
    textLabel.TextColor3 = Color3.fromRGB(255,255,255)
    textLabel.TextSize = 16
    textLabel.Font = Enum.Font.GothamBold
    textLabel.TextStrokeColor3 = Color3.fromRGB(0,0,0)
    textLabel.TextStrokeTransparency = 0.3
    textLabel.Parent = bill
    espObjects[plr] = {Highlight = highlight, Billboard = bill}
end

local function removeESPForPlayer(plr)
    local data = espObjects[plr]
    if data then
        if data.Highlight then data.Highlight:Destroy() end
        if data.Billboard then data.Billboard:Destroy() end
        espObjects[plr] = nil
    end
end

local function updateRainbow()
    local color = Color3.fromHSV((os.clock()*0.3)%1, 1, 1)
    for _, data in pairs(espObjects) do
        if data.Highlight then data.Highlight.FillColor = color end
    end
end

local function enableESP()
    if espActive then return end
    espActive = true
    espStatusLabel.Text, espStatusLabel.TextColor3 = "ESP: ON", Color3.fromRGB(180,220,180)
    glowBtn.Text, glowBtn.BackgroundColor3 = "GLOW ON", Color3.fromRGB(100,70,70)
    for _, plr in pairs(Players:GetPlayers()) do createESPForPlayer(plr) end
    Players.PlayerAdded:Connect(function(plr) if espActive then createESPForPlayer(plr) end end)
    Players.PlayerRemoving:Connect(removeESPForPlayer)
    for _, plr in pairs(Players:GetPlayers()) do
        if plr ~= player then
            plr.CharacterAdded:Connect(function()
                if espActive then removeESPForPlayer(plr) createESPForPlayer(plr) end
            end)
        end
    end
    if rainbowConnection then rainbowConnection:Disconnect() end
    rainbowConnection = RunService.RenderStepped:Connect(updateRainbow)
end

local function disableESP()
    if not espActive then return end
    espActive = false
    espStatusLabel.Text, espStatusLabel.TextColor3 = "ESP: OFF", Color3.fromRGB(180,180,180)
    glowBtn.Text, glowBtn.BackgroundColor3 = "GLOW OFF", Color3.fromRGB(60,60,65)
    for plr, _ in pairs(espObjects) do removeESPForPlayer(plr) end
    espObjects = {}
    if rainbowConnection then rainbowConnection:Disconnect() rainbowConnection = nil end
end

glowBtn.MouseButton1Click:Connect(function() if espActive then disableESP() else enableESP() end end)

