local function touchCycle()
    if not targetPart then
        targetPart = getTargetPart()
        if not targetPart then
            statusLabel.Text, statusLabel.TextColor3 = "TARGET LOST", Color3.fromRGB(200,100,100)
            return
        end
    end
    if not rootPart or not rootPart.Parent then return end
    local originalCF = rootPart.CFrame
    rootPart.CFrame = CFrame.new(targetPart.Position + Vector3.new(0,2.5,0))
    task.wait(delayVal)
    pcall(function() targetPart:FireTouchInterest(rootPart) end)
    rootPart.CFrame = originalCF
    touchCount = touchCount + 1
    counterLabel.Text = "TOUCHES: "..touchCount
    task.wait(delayVal)
end

local function runLoop()
    while isActive do
        if not rootPart or not rootPart.Parent or not humanoid or humanoid.Health <= 0 then stopLoop() break end
        touchCycle()
    end
end

local function startLoop()
    if isActive then return end
    if not targetPart then
        targetPart = getTargetPart()
        if not targetPart then statusLabel.Text, statusLabel.TextColor3 = "TARGET NOT FOUND", Color3.fromRGB(200,100,100) return end
    end
    if not rootPart or not rootPart.Parent or not humanoid or humanoid.Health <= 0 then
        statusLabel.Text, statusLabel.TextColor3 = "WAIT FOR CHARACTER", Color3.fromRGB(200,180,0)
        return
    end
    isActive = true
    touchCount = 0
    counterLabel.Text = "TOUCHES: 0"
    loopThread = coroutine.create(runLoop)
    coroutine.resume(loopThread)
    statusLabel.Text, statusLabel.TextColor3 = "ACTIVE", Color3.fromRGB(180,220,180)
    toggleBtn.Text, toggleBtn.BackgroundColor3 = "STOP", Color3.fromRGB(100,70,70)
end

local function stopLoop()
    if not isActive then return end
    isActive = false
    loopThread = nil
    targetPart = getTargetPart()
    statusLabel.Text = targetPart and "TARGET FOUND" or "TARGET NOT FOUND"
    statusLabel.TextColor3 = targetPart and Color3.fromRGB(180,180,180) or Color3.fromRGB(200,100,100)
    toggleBtn.Text, toggleBtn.BackgroundColor3 = "START", Color3.fromRGB(70,70,75)
end

toggleBtn.MouseButton1Click:Connect(function() if isActive then stopLoop() else startLoop() end end)

-- ===== CHARACTER RESPAWN =====
player.CharacterAdded:Connect(function(newChar)
    if isActive then stopLoop() end
    if flyActive then disableFly() flyStatus = false flyBtn.Text, flyBtn.BackgroundColor3 = "FLY OFF", Color3.fromRGB(60,60,65) end
    if noclipActive then
        if character then removeNoclip(character) end
        applyNoclip(newChar)
    end
    character = newChar
    rootPart = character:FindFirstChild("HumanoidRootPart")
    humanoid = character:FindFirstChild("Humanoid")
    if humanoid then
        humanoid.WalkSpeed = 16 * savedSpeed
        humanoid.JumpPower = 50 * savedJump
    end
    targetPart = getTargetPart()
    statusLabel.Text = targetPart and "TARGET FOUND" or "TARGET NOT FOUND"
    statusLabel.TextColor3 = targetPart and Color3.fromRGB(180,180,180) or Color3.fromRGB(200,100,100)
    toggleBtn.Text, toggleBtn.BackgroundColor3 = "START", Color3.fromRGB(70,70,75)
    touchCount = 0
    counterLabel.Text = "TOUCHES: 0"
    if isMinimized then expand() end
    mainFrame.Visible = true
    minimizedFrame.Visible = false
end)

