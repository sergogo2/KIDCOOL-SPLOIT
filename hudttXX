function enableFly()
    if not character or not rootPart or not humanoid then return end
    flyActive = true
    humanoid.PlatformStand = true
    flyBodyVelocity = Instance.new("BodyVelocity")
    flyBodyVelocity.MaxForce = Vector3.new(1e6,1e6,1e6)
    flyBodyVelocity.Velocity = Vector3.new(0,0,0)
    flyBodyVelocity.Parent = rootPart
end

function disableFly()
    flyActive = false
    if humanoid then humanoid.PlatformStand = false end
    if flyBodyVelocity then flyBodyVelocity:Destroy() flyBodyVelocity = nil end
end

RunService.RenderStepped:Connect(function()
    if not flyActive or not rootPart or not flyBodyVelocity then return end
    local cam = workspace.CurrentCamera
    if not cam then return end
    local forward, right, up = cam.CFrame.LookVector, cam.CFrame.RightVector, cam.CFrame.UpVector
    local moveVec = Vector3.new(
        (UserInputService:IsKeyDown(Enum.KeyCode.D) and 1 or 0) - (UserInputService:IsKeyDown(Enum.KeyCode.A) and 1 or 0),
        (UserInputService:IsKeyDown(Enum.KeyCode.Space) and 1 or 0) - (UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) and 1 or 0),
        (UserInputService:IsKeyDown(Enum.KeyCode.W) and 1 or 0) - (UserInputService:IsKeyDown(Enum.KeyCode.S) and 1 or 0)
    )
    local move = right*moveVec.X + up*moveVec.Y + forward*moveVec.Z
    if move.Magnitude > 0 then
        move = move.Unit * 50
        rootPart.CFrame = CFrame.new(rootPart.Position, rootPart.Position + move.Unit)
    else
        rootPart.CFrame = CFrame.new(rootPart.Position, rootPart.Position + forward)
    end
    flyBodyVelocity.Velocity = move
end)

