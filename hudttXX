local noclipActive, noclipConnections = false, {}

local function setPartsCollide(parts, value)
    for _, part in ipairs(parts) do
        if part:IsA("BasePart") then
            part.CanCollide = value
        end
    end
end

local function applyNoclip(character)
    if not character then return end
    local parts = character:GetDescendants()
    setPartsCollide(parts, false)
    local conn = character.DescendantAdded:Connect(function(part)
        if part:IsA("BasePart") and noclipActive then
            part.CanCollide = false
        end
    end)
    table.insert(noclipConnections, conn)
end

local function removeNoclip(character)
    if not character then return end
    local parts = character:GetDescendants()
    setPartsCollide(parts, true)
    for _, conn in ipairs(noclipConnections) do
        conn:Disconnect()
    end
    noclipConnections = {}
end

local function enableNoclip()
    if noclipActive then return end
    noclipActive = true
    noclipStatusLabel.Text, noclipStatusLabel.TextColor3 = "NOCLIP: ON", Color3.fromRGB(180,220,180)
    noclipBtn.Text, noclipBtn.BackgroundColor3 = "NOCLIP ON", Color3.fromRGB(100,70,70)
    if character then applyNoclip(character) end
end

local function disableNoclip()
    if not noclipActive then return end
    noclipActive = false
    noclipStatusLabel.Text, noclipStatusLabel.TextColor3 = "NOCLIP: OFF", Color3.fromRGB(180,180,180)
    noclipBtn.Text, noclipBtn.BackgroundColor3 = "NOCLIP OFF", Color3.fromRGB(60,60,65)
    if character then removeNoclip(character) end
end

noclipBtn.MouseButton1Click:Connect(function() if noclipActive then disableNoclip() else enableNoclip() end end)

